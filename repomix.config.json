{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "showLineNumbers": true
  },
  "include": [
    "**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "node_modules/**",
      "dist/**",
      ".env*",
      "*.log"
    ]
  }
}
