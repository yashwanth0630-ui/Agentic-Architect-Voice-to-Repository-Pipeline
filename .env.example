PORT=3000
NODE_ENV=development
API_SECRET_KEY=replace_with_internal_secret

# Phase 2A: GitHub Integration (Personal Access Token or Fine-Grained Token fallback)
# Create at https://github.com/settings/tokens (Needs 'repo' or read:user/metadata permissions)
GITHUB_TOKEN=your_github_personal_access_token_here

# Phase 2B / 2C: GitHub OAuth Device Authorization Flow (RFC 8628 - Recommended)
# To create an OAuth App for Device Flow:
# 1. Go to https://github.com/settings/developers -> New OAuth App
# 2. Application name: Idea Beacon
# 3. Homepage URL: http://localhost:8000
# 4. Check "Enable Device Flow"
# 5. Copy the "Client ID" below (Client Secret is NOT needed for Device Flow)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id_here

