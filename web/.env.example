# Idea Beacon Web UI — Environment Configuration
# Copy to .env and populate values as needed

# Bridge URL for the Python laptop bridge (default for local dev)
VITE_BRIDGE_URL=http://127.0.0.1:8000

# Node API URL (default for local dev via Vite proxy)
VITE_API_URL=/api

# Set to "true" to disable HMR (useful during AI agent edits)
DISABLE_HMR=false
